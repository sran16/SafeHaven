{
  "appId": "com.safehavenapp.ranim",
  "appName": "safehaven",
  "webDir": "dist",
  "bundledWebRuntime": false,
  "server": {
    "allowNavigation": [
      "http://10.0.2.2:3000/*",
      "http://localhost:3000/*",
      "http://127.0.0.1:3000/*",
      "http://localhost/*",
      "http://*.local/*",
      "http://192.168.*.*:*/*"
    ],
    "cleartext": true,
    "hostname": "localhost"
  },
  "ios": {
    "scheme": "App",
    "contentInset": "always"
  }
}
