generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Users {
  id_user           Int                @id @default(autoincrement())
  name              String
  email             String             @unique
  password          String
  registration_Date DateTime           @default(now())
  answers           Answers[]
  chatbotSessions   Chatbot_sessions[]
  experiences       Experiences[]
  moods             Moods[]
  logs              UserLogs[]
  activeSessions    ActiveSessions[]

  @@index([email])
  @@index([name])
  @@index([registration_Date])
}

model Moods {
  id_mood          Int      @id @default(autoincrement())
  dateRegistration DateTime @default(now())
  moodType         String
  description      String
  userId           Int
  user             Users    @relation(fields: [userId], references: [id_user], onDelete: Cascade)

  @@index([dateRegistration])
}

model Chatbot_sessions {
  id_session       Int      @id @default(autoincrement())
  startDate        DateTime @default(now())
  endDate          DateTime?

  userId           Int
  user             Users    @relation(fields: [userId], references: [id_user], onDelete: Cascade)

  ia               IA?
  messages         Chat_Messages[]
  report           Session_Reports?
}

model Chat_Messages {
  id_message       Int      @id @default(autoincrement())
  content          String
  isUserMessage    Boolean  // true pour message utilisateur, false pour message IA
  timestamp        DateTime @default(now())

  sessionId        Int
  session          Chatbot_sessions @relation(fields: [sessionId], references: [id_session], onDelete: Cascade)

  @@index([timestamp])
  @@index([sessionId])
}

model Session_Reports {
  id_report        Int      @id @default(autoincrement())
  sessionId        Int      @unique
  session          Chatbot_sessions @relation(fields: [sessionId], references: [id_session], onDelete: Cascade)
  
  // Données du rapport
  distressLevel    Int      // 1-5
  emergency        Boolean  @default(false)
  sentiment        String   // positive, negative, neutral
  topics           String[] // ["burnout", "stress", "work"]
  language         String   // french, english
  
  // Recommandations
  immediateRecommendations String[] // ["pause", "respiration"]
  longTermRecommendations  String[] // ["psychologue", "thérapie"]
  
  // Suivi
  followUpNeeded   Boolean  @default(false)
  followUpUrgency  String   // low, medium, high
  suggestedTiming  String   // "48h", "1 semaine"
  
  // Notes professionnelles
  professionalNotes String? // Notes pour le psychologue
  
  createdAt        DateTime @default(now())
  
  @@index([createdAt])
  @@index([distressLevel])
  @@index([emergency])
}

model IA {
  id_IA              Int    @id @default(autoincrement())
  sentimentAnalysis  String 
  recommendation     String 
  reportGenerated    String 

  chatbotSessionId   Int    @unique
  chatbotSession     Chatbot_sessions @relation(fields: [chatbotSessionId], references: [id_session], onDelete: Cascade)
}

model Experiences {
  id_experience    Int              @id @default(autoincrement())
  content          String
  publication_date DateTime         @default(now())
  userId           Int
  moderateurId     Int?
  answers          Answers[]
  moderateur       Moderateurs?     @relation(fields: [moderateurId], references: [id_moderateur])
  user             Users            @relation(fields: [userId], references: [id_user], onDelete: Cascade)
  moderationLogs   ModerationLogs[]

  @@index([publication_date])
}

model Answers {
  id_response     Int         @id @default(autoincrement())
  content         String
  publicationDate DateTime    @default(now())
  experienceId    Int
  userId          Int
  experience      Experiences @relation(fields: [experienceId], references: [id_experience], onDelete: Cascade)
  user            Users       @relation(fields: [userId], references: [id_user], onDelete: Cascade)

  @@index([publicationDate])
}

model Moderateurs {
  id_moderateur  Int              @id @default(autoincrement())
  experiences    Experiences[]
  moderationLogs ModerationLogs[]

  @@index([id_moderateur])
}

model UserLogs {
  id_log    Int      @id @default(autoincrement())
  action    String
  timestamp DateTime @default(now())
  userId    Int
  user      Users    @relation(fields: [userId], references: [id_user], onDelete: Cascade)

  @@index([timestamp])
}

model ModerationLogs {
  id_log       Int          @id @default(autoincrement())
  action       String
  timestamp    DateTime     @default(now())
  experienceId Int?
  moderatorId  Int
  experience   Experiences? @relation(fields: [experienceId], references: [id_experience], onDelete: Cascade)
  moderator    Moderateurs  @relation(fields: [moderatorId], references: [id_moderateur], onDelete: Cascade)

  @@index([timestamp])
}

model ActiveSessions {
  id          String   @id @default(cuid())
  token       String   @unique
  userId      Int
  user        Users    @relation(fields: [userId], references: [id_user], onDelete: Cascade)
  createdAt   DateTime @default(now())
  expiresAt   DateTime
  isActive    Boolean  @default(true)
  deviceInfo  String?  
  
  @@index([userId])
  @@index([token])
  @@index([expiresAt])
  @@index([isActive])
}
